{
  "rules": {
    "site": {
      "content": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "batches": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "fees": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "faqs": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "testimonials": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "announcement": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "leads": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$lead": {
          ".write": "(!data.exists() && newData.exists() && newData.child('email').isString()) || auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChild('email') && newData.child('email').isString() && newData.child('email').val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/)"
        }
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email'])",
        "email": { ".validate": "newData.isString()" },
        "name": { ".validate": "newData.isString()" },
        "phone": { ".validate": "newData.isString()" },
        "exam": { ".validate": "newData.isString()" },
        "speed": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "lastLogin": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" }
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && auth.token.email === 'admin@example.com') || auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.isBoolean()"
      }
    }
  }
}
